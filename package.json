{
  "name": "vermieter-cockpit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "services/*",
    "webapps/*"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "yarn workspaces foreach --topological-dev --verbose run build",
    "typecheck": "yarn workspaces foreach --verbose run typecheck",
    "test": "yarn workspaces foreach --verbose run test",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint services webapps scripts eslint.config.mjs",
    "format": "prettier --write services webapps scripts docs/development/design-tokens.css eslint.config.mjs",
    "format:check": "prettier --check services webapps scripts docs/development/design-tokens.css eslint.config.mjs",
    "size:check": "node scripts/file-size-check.mjs",
    "api:inventory": "yarn workspace @vermieter-cockpit/de-backend run api:inventory",
    "api:inventory:check": "yarn workspace @vermieter-cockpit/de-backend run api:inventory:check"
  },
  "packageManager": "yarn@3.3.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1"
  }
}
