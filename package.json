{
  "name": "vermieter-cockpit",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "build": "yarn workspaces foreach --topological-dev --verbose run build",
    "typecheck": "yarn workspaces foreach --verbose run typecheck",
    "test": "yarn workspaces foreach --verbose run test",
    "lint": "eslint services scripts eslint.config.mjs",
    "format": "prettier --write services scripts eslint.config.mjs",
    "format:check": "prettier --check services scripts eslint.config.mjs",
    "size:check": "node scripts/file-size-check.mjs"
  },
  "packageManager": "yarn@3.3.0",
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "eslint": "9.13.0",
    "prettier": "3.3.3",
    "typescript-eslint": "8.12.2"
  }
}
