# Vorlage für .env (issue #281, Punkt 4; docs/development/betrieb.md, Abschnitt 9).
#
#   cp .env.example .env && chmod 600 .env
#
# docker compose liest .env im Projektverzeichnis automatisch. .env ist in .gitignore und wird nie committet.
#
# ALLE Werte unten sind Platzhalter. docker-compose.yml setzt für jedes Secret einen bekannten Entwicklungs-Default
# ein, wenn die Variable fehlt; in der produktiven Installation MUSS deshalb jede Variable dieses Abschnitts gesetzt
# und mit einem eigenen Zufallswert überschrieben sein. Erzeugen z. B. mit: openssl rand -hex 32
# Hex-Werte verwenden: DE_DB_PASSWORD steht ungeschützt in einer URL (DATABASE_URL), Zeichen wie @ : / ? # brechen sie.
#
# Einmal vor dem ersten Start setzen und danach nicht mehr ändern (siehe die Hinweise je Variable).

###############################################################################
# DE (PostgreSQL)
###############################################################################

# Datenbankbenutzer der DE-Datenbank. Kein Secret, aber zusammen mit dem Passwort vor dem ersten Start festlegen.
DE_DB_USER=de
# Datenbankname der DE-Datenbank. Kein Secret.
DE_DB_NAME=de
# Passwort des DE-Datenbankbenutzers (Default in docker-compose.yml: de_dev_password). Postgres übernimmt es nur
# beim ersten Initialisieren des Volumes de-postgres-data; eine spätere Änderung hier ändert das Passwort in der
# Datenbank nicht (dann ALTER ROLE, sonst verbindet sich das Backend nicht mehr).
DE_DB_PASSWORD=CHANGE_ME_hex_32_bytes

###############################################################################
# MRE (gepinnte Baseline)
###############################################################################

# Passwort von Redis, in dem der MRE-Authenticator die Refresh-Tokens hält (Default: redis_password).
REDIS_PASSWORD=CHANGE_ME_hex_32_bytes
# Signiert die MRE-Access-Tokens (HS256, §47.1); wer ihn kennt, kann Tokens für jedes Konto fälschen und damit
# auch die DE-API benutzen (Default: access_token_secret). Eine Änderung beendet alle Sitzungen.
ACCESS_TOKEN_SECRET=CHANGE_ME_hex_32_bytes
# Signiert die Refresh-Tokens des Authenticators (Default: refresh_token_secret).
REFRESH_TOKEN_SECRET=CHANGE_ME_hex_32_bytes
# Signiert die Tokens zum Zurücksetzen des Passworts (Default: reset_token_secret).
RESET_TOKEN_SECRET=CHANGE_ME_hex_32_bytes
# Signiert die Application Credentials von MRE (Default: appcredz_token_secret).
APPCREDZ_TOKEN_SECRET=CHANGE_ME_hex_32_bytes
# Schlüssel, mit dem MRE vertrauliche Felder in MongoDB verschlüsselt (AES-256-CBC, SHA-256 des Werts;
# Default: cipher_key). NICHT mehr ändern, sobald Daten existieren: danach ist Verschlüsseltes nicht mehr lesbar.
# Zusammen mit dem Backup aufbewahren.
CIPHER_KEY=CHANGE_ME_hex_32_bytes
# Initialisierungsvektor dazu (Default: cipher_iv_key). Gleiche Regel wie CIPHER_KEY.
CIPHER_IV_KEY=CHANGE_ME_hex_32_bytes

# Gepinnter MRE-Stand (ADR-036, mre-integration.md §55). Kein Secret; nur bei einem dokumentierten Upgrade ändern.
# MRE_VERSION=479d0ad703436071b64dfdf4e48321c121d8efb5

###############################################################################
# Reverse-Proxy (nur mit docker-compose.proxy.yml)
###############################################################################

# Interner Hostname der Installation, nur im VPN auflösbar (nie im öffentlichen DNS). Wird auch die Cookie-Domain
# des MRE-Refresh-Tokens (APP_DOMAIN des Authenticators) und muss genau der Name sein, den der Browser aufruft.
COCKPIT_HOSTNAME=cockpit.internal
# Adresse der VPN-Schnittstelle des Hosts, an die Port 443 gebunden wird (WireGuard z. B. 10.8.0.1, Tailscale
# 100.x.y.z). Nie 0.0.0.0 und nie eine öffentliche Adresse. Ohne Angabe 127.0.0.1 (nur vom Host selbst erreichbar).
PROXY_BIND_ADDRESS=127.0.0.1
# Ziel für /cockpit, sobald webapps/cockpit als Dienst läuft (Default: cockpit-ui:80). Bis dahin antwortet /cockpit 502.
# COCKPIT_UI_UPSTREAM=cockpit-ui:80
# Selbstregistrierung im MRE-Authenticator (Default false). Nur für das erste Vermieterkonto einmalig true, den
# Authenticator neu erstellen, danach wieder false und erneut neu erstellen (betrieb.md, Abschnitt 9.4).
MRE_SIGNUP=false

###############################################################################
# Bewusst NICHT hier
###############################################################################
# DEPRECIATION_RECORDING_ENABLED bleibt ungesetzt (aus). docker-compose.yml reicht die Variable nicht an den
# de-backend-Container durch; ein Eintrag hier hätte keine Wirkung. Einschalten nur nach api-design.md §60
# "Turning it on" (betrieb.md, Abschnitt 9.7 "AfA-Erfassung").
